# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./social_agent.db

# LLM provider is disabled until explicitly configured.
LLM_PROVIDER=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Channel adapters remain disabled until official credentials and approvals exist.
META_ENABLED=false
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TIKTOK_ENABLED=false

# Scheduler adapter: demo only until a real clinic scheduling system is integrated.
SCHEDULER_PROVIDER=demo
